 "components": {
  "schemas": {
   "Activity": {
    "properties": {
     "state": {
      "type": "string",
      "enum": [
       "ongoing",
       "ended",
       "unknown"
      ],
      "title": "State"
     },
     "recurrence": {
      "type": "string",
      "title": "Recurrence"
     },
     "period_seconds": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Period Seconds"
     },
     "rate_per_minute": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Rate Per Minute"
     },
     "active_windows": {
      "type": "integer",
      "title": "Active Windows"
     },
     "peak_window_start": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Peak Window Start"
     },
     "peak_window_count": {
      "type": "integer",
      "title": "Peak Window Count"
     }
    },
    "type": "object",
    "required": [
     "state",
     "recurrence",
     "period_seconds",
     "rate_per_minute",
     "active_windows",
     "peak_window_start",
     "peak_window_count"
    ],
    "title": "Activity"
   },
   "EventOut": {
    "properties": {
     "event_id": {
      "type": "string",
      "title": "Event Id"
     },
     "line_no": {
      "type": "integer",
      "title": "Line No"
     },
     "timestamp": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Timestamp"
     },
     "level": {
      "type": "string",
      "title": "Level"
     },
     "service": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Service"
     },
     "logger": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Logger"
     },
     "message": {
      "type": "string",
      "title": "Message"
     },
     "stack_trace": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Stack Trace"
     },
     "fields": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Fields"
     },
     "metrics": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object",
      "title": "Metrics"
     },
     "fingerprint": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fingerprint"
     }
    },
    "type": "object",
    "required": [
     "event_id",
     "line_no",
     "timestamp",
     "level",
     "service",
     "logger",
     "message",
     "stack_trace",
     "fields",
     "metrics",
     "fingerprint"
    ],
    "title": "EventOut"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ImportDetail": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "filename": {
      "type": "string",
      "title": "Filename"
     },
     "format": {
      "type": "string",
      "title": "Format"
     },
     "default_service": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Default Service"
     },
     "size_bytes": {
      "type": "integer",
      "title": "Size Bytes"
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
     },
     "event_count": {
      "type": "integer",
      "title": "Event Count"
     },
     "incident_count": {
      "type": "integer",
      "title": "Incident Count"
     },
     "first_event": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "First Event"
     },
     "last_event": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Event"
     },
     "window_seconds": {
      "type": "integer",
      "title": "Window Seconds"
     },
     "truncated": {
      "type": "boolean",
      "title": "Truncated"
     },
     "duplicate": {
      "type": "boolean",
      "title": "Duplicate",
      "default": false
     },
     "level_counts": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Level Counts"
     },
     "service_counts": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Service Counts"
     },
     "diagnostics": {
      "additionalProperties": true,
      "type": "object",
      "title": "Diagnostics"
     },
     "timeline": {
